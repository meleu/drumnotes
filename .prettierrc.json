{
  "plugins": ["prettier-plugin-svelte"],
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.svelte",
      "options": { "parser": "svelte" }
    },
    {
      "files": "*.md",
      "options": { "printWidth": 90, "proseWrap": "always" }
    }
  ]
}
